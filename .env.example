# Copy this file to .env and paste a newly rotated key locally.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RAG_DEVICE=auto
CHUNK_CHARS=1800
CHUNK_OVERLAP=240
RETRIEVAL_K=8
CANDIDATE_K=24
